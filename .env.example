POSTGRES_USER=fiber
# Change both change-me values (the same password in each); the API refuses to start while they remain.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fiber
DATABASE_URL=postgresql+psycopg://fiber:change-me@db:5432/fiber
APP_ENV=production
# The site is served over plain HTTP (no TLS), so the session cookie must not be marked Secure,
# or the browser drops it and nobody can sign in. Set 1 only if the site is reached over HTTPS.
COOKIE_SECURE=0
# Port the site is reached on: http://SERVER:API_PORT
API_PORT=8000
# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Login session lifetime in hours
SESSION_HOURS=12
