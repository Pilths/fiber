POSTGRES_USER=fiber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fiber
DATABASE_URL=postgresql+psycopg://fiber:change-me@db:5432/fiber
APP_ENV=development
# Lets requests log in as any user with an X-Dev-User header. Development only: the API refuses to start with it
# outside APP_ENV=development. Leave it out of any shared or production .env.
ALLOW_DEV_HEADER=1
# Cookie Secure flag: 1 or 0. Without it, Secure only when APP_ENV=production.
# COOKIE_SECURE=1
# Log level: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO
SESSION_SECRET=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Password for the seeded dev users (planner1, admin1, ...). Development only; never use in production.
DEV_PASSWORD=dev-password-123
# Login session lifetime in hours
SESSION_HOURS=12
